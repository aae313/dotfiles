binds {
    // === Apps ===
    Mod+Return hotkey-overlay-title="OpenTerminal" {
        spawn "nirius" "focus-or-spawn" "--app-id" "kitty" "app2unit-term"
    }
    Mod+Ctrl+Return hotkey-overlay-title="OpenTerminal" {
        spawn "xdg-terminal-exec"
    }
    Mod+E hotkey-overlay-title="OpenNeovide" {
        spawn "nirius" "focus-or-spawn" "--app-id" "^neovide$" "neovide"
    }
    Mod+BackSpace {
        spawn "nirius" "focus" "--focused-workspace" "--app-id" "firefox-nightly"
    }
    Mod+Shift+BackSpace {
        spawn "app2unit" "firefox-nightly"
    }
    Mod+Shift+B hotkey-overlay-title="OpenBook" {
        spawn "open-book"
    }
    Mod+B hotkey-overlay-title="OpenBookmark" {
        spawn "open-bookmark"
    }
    Mod+Shift+Semicolon {
        spawn "fuzzel"
    }
    Mod+C repeat=false {
        spawn-sh "cliphist list | fuzzel --dmenu --font='monospace:size=9' --width=120 | cliphist decode | wl-copy"
    }
    // === Scratchpad ===
    Mod+A repeat=false {
        spawn "niri-static-scratchpad" "org.mozilla.firefox.webapp-f1a423e1-22ba-401c-840f-7036c59c0ecb" "~/.local/share/applications/org.mozilla.firefox.webapp-f1a423e1-22ba-401c-840f-7036c59c0ecb.desktop"
    }
    Mod+Period {
        spawn "nirius" "scratchpad-show"
    }
    Mod+Shift+Period hotkey-overlay-title="scratchpad-toggle" {
        spawn "nirius" "scratchpad-toggle"
    }
    Mod+Ctrl+Period hotkey-overlay-title="scratchpad-toggle" {
        spawn "nirius" "scratchpad-show-all"
    }
    // === Windows ===
    Mod+Shift+Q {
        close-window
    }
    Mod+O repeat=false {
        toggle-overview
    }
    Mod+G {
        toggle-column-tabbed-display
    }
    Mod+F {
        toggle-window-floating
    }
    Mod+Shift+F {
        switch-focus-between-floating-and-tiling
    }
    Mod+Comma {
        consume-window-into-column
    }
    Mod+Ctrl+BracketLeft {
        consume-or-expel-window-left
    }
    Mod+Ctrl+BracketRight {
        consume-or-expel-window-right
    }
    // === Sizing ===
    Mod+W {
        switch-preset-column-width
    }
    Mod+Shift+W {
        switch-preset-column-width-back
    }
    Mod+R {
        reset-window-height
    }
    Mod+Shift+R {
        switch-preset-window-height
    }
    Mod+Space {
        maximize-column
    }
    Mod+Shift+Space {
        fullscreen-window
    }
    Mod+Ctrl+Space {
        expand-column-to-available-width
    }
    Mod+Minus {
        set-column-width "-10%"
    }
    Mod+Equal {
        set-column-width "+10%"
    }
    Mod+0 {
        set-column-width "50%"
    }
    Mod+Shift+Minus {
        set-window-height "-10%"
    }
    Mod+Shift+Equal {
        set-window-height "+10%"
    }
    // === Centering ===
    Mod+Z {
        center-window
    }
    Mod+Shift+Z {
        center-column
    }
    Mod+Ctrl+Z {
        center-visible-columns
    }
    Mod+Alt+Z hotkey-overlay-title="ToggleCenterFocusedColumn" {
        spawn "niri-toggle-center-focused-column"
    }
    Mod+Ctrl+Shift+Z {
        spawn-sh "niri msg action focus-column-left; niri msg action focus-column-right"
    }
    // === Navigate: columns ===
    Mod+H {
        focus-column-left-or-last
    }
    Mod+Left {
        focus-column-left-or-last
    }
    Mod+L {
        focus-column-right-or-first
    }
    Mod+Right {
        focus-column-right-or-first
    }
    Mod+BracketLeft {
        focus-column-left-or-last
    }
    Mod+BracketRight {
        focus-column-right-or-first
    }
    Mod+Home {
        focus-column-first
    }
    Mod+End {
        focus-column-last
    }
    // === Navigate: windows ===
    Mod+J {
        focus-window-down-or-top
    }
    Mod+Down {
        focus-window-down-or-top
    }
    Mod+K {
        focus-window-up-or-bottom
    }
    Mod+Up {
        focus-window-up-or-bottom
    }
    // === Navigate: workspaces ===
    Mod+Page_Up {
        focus-workspace-up
    }
    Mod+Page_Down {
        focus-workspace-down
    }
    // === Move: columns ===
    Mod+Shift+H {
        move-column-left
    }
    Mod+Shift+Left {
        move-column-left
    }
    Mod+Shift+L {
        move-column-right
    }
    Mod+Shift+Right {
        move-column-right
    }
    Mod+Shift+BracketLeft {
        move-column-left-or-to-monitor-left
    }
    Mod+Shift+BracketRight {
        move-column-right-or-to-monitor-right
    }
    Mod+Shift+Home {
        move-column-to-first
    }
    Mod+Shift+End {
        move-column-to-last
    }
    // === Move: windows ===
    Mod+Shift+J {
        move-window-down
    }
    Mod+Shift+Down {
        move-window-down
    }
    Mod+Shift+K {
        move-window-up
    }
    Mod+Shift+Up {
        move-window-up
    }
    // === Resize: directional ===
    Mod+Ctrl+H {
        set-column-width "-10%"
    }
    Mod+Ctrl+Left {
        set-column-width "-10%"
    }
    Mod+Ctrl+L {
        set-column-width "+10%"
    }
    Mod+Ctrl+Right {
        set-column-width "+10%"
    }
    Mod+Ctrl+J {
        set-window-height "+10%"
    }
    Mod+Ctrl+Down {
        set-window-height "+10%"
    }
    Mod+Ctrl+K {
        set-window-height "-10%"
    }
    Mod+Ctrl+Up {
        set-window-height "-10%"
    }
    // === Move: floating windows ===
    Mod+Alt+H {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "-20" "--y" "+0"
    }
    Mod+Alt+Left {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "-20" "--y" "+0"
    }
    Mod+Alt+J {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "+0" "--y" "+20"
    }
    Mod+Alt+Down {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "+0" "--y" "+20"
    }
    Mod+Alt+K {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "+0" "--y" "-20"
    }
    Mod+Alt+Up {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "+0" "--y" "-20"
    }
    Mod+Alt+L {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "+20" "--y" "+0"
    }
    Mod+Alt+Right {
        spawn "niri" "msg" "action" "move-floating-window" "--x" "+20" "--y" "+0"
    }
    // === Move: to monitor ===
    Mod+M {
        focus-monitor-next
    }
    Mod+Shift+M hotkey-overlay-title="send to next monitor" {
        move-window-to-monitor-next
    }
    Mod+Shift+Ctrl+H {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+Left {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+L {
        move-column-to-monitor-right
    }
    Mod+Shift+Ctrl+Right {
        move-column-to-monitor-right
    }
    // === Move: to workspace ===
    Mod+Shift+Page_Up {
        move-column-to-workspace-up
    }
    Mod+Shift+Page_Down {
        move-column-to-workspace-down
    }
    Mod+Ctrl+Shift+Page_Up {
        move-workspace-up
    }
    Mod+Ctrl+Shift+Page_Down {
        move-workspace-down
    }
    // === Workspaces ===
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Shift+1 {
        move-column-to-workspace 1
    }
    Mod+Shift+2 {
        move-column-to-workspace 2
    }
    Mod+Shift+3 {
        move-column-to-workspace 3
    }
    Mod+Shift+4 {
        move-column-to-workspace 4
    }
    Mod+Shift+5 {
        move-column-to-workspace 5
    }
    Mod+Shift+6 {
        move-column-to-workspace 6
    }
    Mod+Shift+7 {
        move-column-to-workspace 7
    }
    Mod+Shift+8 {
        move-column-to-workspace 8
    }
    Mod+Shift+9 {
        move-column-to-workspace 9
    }
    // === Scroll ===
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }
    Mod+Shift+WheelScrollDown cooldown-ms=150 {
        move-column-to-workspace-down
    }
    Mod+Shift+WheelScrollUp cooldown-ms=150 {
        move-column-to-workspace-up
    }
    Mod+WheelScrollRight {
        focus-column-right
    }
    Mod+WheelScrollLeft {
        focus-column-left
    }
    Mod+Shift+WheelScrollRight {
        move-column-right
    }
    Mod+Shift+WheelScrollLeft {
        move-column-left
    }
    // Ctrl+vertical scroll provides horizontal movement for mice without tilt wheels
    Mod+Ctrl+WheelScrollDown {
        focus-column-right
    }
    Mod+Ctrl+WheelScrollUp {
        focus-column-left
    }
    Mod+Ctrl+Shift+WheelScrollDown {
        move-column-right
    }
    Mod+Ctrl+Shift+WheelScrollUp {
        move-column-left
    }
    // === Screenshot ===
    Print {
        screenshot
    }
    Ctrl+Print {
        screenshot-screen
    }
    Alt+Print {
        screenshot-window
    }
    // === System ===
    Mod+Shift+Escape hotkey-overlay-title="ShowHotkeyOverlay" {
        show-hotkey-overlay
    }
    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit
    }
    Mod+Alt+Delete {
        spawn "systemctl" "--user" "stop" "niri.service"
    }
    Mod+F7 {
        spawn "niri" "msg" "output" "ASUSTek COMPUTER INC PA278QV SCLMQS108511" "scale" "1"
    }
    Mod+F8 {
        spawn "niri" "msg" "output" "ASUSTek COMPUTER INC PA278QV SCLMQS108511" "scale" "1.25"
    }
}
