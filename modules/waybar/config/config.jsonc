{
  "layer": "top",
  "output": [
    "DP-1",
    "eDP-1"
  ],
  "position": "top",
  "height": 30,
  "spacing": 0,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "modules-left": [],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "clock"
  ],
  "clock": {
    "format": "{:%H:%M}"
  },
  "hyprland/workspaces": {
    "format": "{windows}",
    "format-window-separator": "",
    "sort-by": "id",
    "all-outputs": true,
    "active-only": false,
    "disable-scroll": false,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    },
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": "{icon}",
      "icon-size": 18,
      "orientation": "horizontal",
      "on-click-window": "/run/current-system/sw/bin/hyprctl dispatch 'hl.dsp.focus({ window = \"address:{address}\" })'"
    }
  }
}
