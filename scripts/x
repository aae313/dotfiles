#!/usr/bin/env bash

if [[ -z ${ZELLIJ_PANE_ID:-} ]]; then
    exec hx "$@"
fi

pane_id=${ZELLIJ_PANE_ID#terminal_}
session=${ZELLIJ_SESSION_NAME:-default}
lock_name=${session//[^[:alnum:]_.-]/_}
lock="${XDG_RUNTIME_DIR:-/tmp}/x-helix-${lock_name}.lock"

exec 9>>"$lock"

# Escape for the Helix command line: backslash protects whitespace, quote
# characters, and a token-initial percent; double quotes would enable
# Helix expansions, so plain escaped tokens are the safe form.
escape_helix_path() {
    local path=$1

    path=${path//"'"/"\\'"}
    path=${path//'"'/'\"'}
    path=${path//'`'/'\`'}
    path=${path//' '/'\ '}
    path=${path//$'\t'/\\$'\t'}

    if [[ $path == %* ]]; then
        path="\\${path}"
    fi

    printf '%s' "$path"
}

route_to_holder() {
    local holder=$1
    shift

    if (($# > 0)); then
        local command=":open" path
        for path in "$@"; do
            path=$(realpath --canonicalize-missing -- "$path") || return 1
            command+=" $(escape_helix_path "$path")"
        done

        zellij action write 27 --pane-id "$holder" 9>&- || return 1
        zellij action write-chars --pane-id "$holder" "$command" 9>&- || return 1
        zellij action write 13 --pane-id "$holder" 9>&- || return 1
    fi

    zellij action focus-pane-id "$holder" 9>&-
}

if ! flock --nonblock 9; then
    holder=$(<"$lock")
    holder=${holder#terminal_}

    if [[ -n $holder ]] && route_to_holder "$holder" "$@"; then
        exit 0
    fi

    exec hx "$@" 9>&-
fi

printf 'terminal_%s\n' "$pane_id" >"$lock"

renamed=0
hx_status=""

cleanup() {
    status=$?

    if [[ -n $hx_status ]]; then
        status=$hx_status
    fi

    : >"$lock"

    if ((renamed)); then
        zellij action undo-rename-pane --pane-id "$pane_id" 9>&- 2>/dev/null || true
    fi

    exit "$status"
}

trap 'cleanup' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if zellij action rename-pane --pane-id "$pane_id" x 9>&-; then
    renamed=1
else
    printf 'x: failed to rename pane, continuing\n' >&2
fi

hx "$@" 9>&-
hx_status=$?
exit "$hx_status"
